<Page
    x:Name="EditProfilePage"
    x:Class="Imgur.Uwp.Views.Accounts.EditProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Imgur.Uwp.Controls"
    xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Windows10FallCreatorsUpdate="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract,5)"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <!--
      ≥500px o topo da página é ancorado no topo da janela pelo code-behind (AnchorToWindowTop):
      a Shell muda a altura acima do MainFrame conforme search/brand/padding, então um Margin
      fixo como o da Account (-50/-80) empurra os overlays para fora da tela nesta rota.
      Overlays (TopBar/Save/Sticky) ficam no grupo ChromeStates, escolhido no code-behind.
    -->
    <Grid x:Name="RootGrid">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" Opacity="0.4" EndPoint="0,1">
                <GradientStop Color="#073169" Offset="1" />
                <GradientStop Color="#292c30" Offset="0.6" />
            </LinearGradientBrush>
        </Grid.Background>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="RootViewTriggers">
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="300" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EditProfilePage.Margin" Value="0,-10,0,0"/>
                        <Setter Target="CoverHeader.Height" Value="260"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="500" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CoverHeader.Height" Value="260"/>
                        <Setter Target="LeaveFloatButton.Background" Value="#AD19191C"/>
                        <Setter Target="AvatarPanel.Width" Value="120"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CoverHeader.Height" Value="350"/>
                        <Setter Target="LeaveFloatButton.MinWidth" Value="34"/>
                        <Setter Target="LeaveFloatButton.MinHeight" Value="34"/>
                        <Setter Target="SaveFloatButton.MinWidth" Value="34"/>
                        <Setter Target="SaveFloatButton.MinHeight" Value="34"/>
                        <Setter Target="AvatarPanel.Width" Value="140"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CoverHeader.Height" Value="400"/>
                        <Setter Target="LeaveFloatButton.MinWidth" Value="34"/>
                        <Setter Target="LeaveFloatButton.MinHeight" Value="34"/>
                        <Setter Target="SaveFloatButton.MinWidth" Value="34"/>
                        <Setter Target="SaveFloatButton.MinHeight" Value="34"/>
                        <Setter Target="AvatarPanel.Width" Value="160"/>
                        <Setter Target="FormBody.Padding" Value="40,16,40,40"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- Posição dos overlays relativa ao topo da janela -->
            <VisualStateGroup x:Name="ChromeStates">
                <VisualState x:Name="ChromeMinimal">
                    <VisualState.Setters>
                        <Setter Target="TopBar.Margin" Value="11,15,0,0"/>
                        <Setter Target="SaveShadow.Margin" Value="0,15,12,0"/>
                        <Setter Target="StickOptionsBarContent.Height" Value="56"/>
                        <Setter Target="StickOptionsBarContent.Padding" Value="8,8,12,8"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- PC: abaixo da área de arraste da title bar (32px) e dos caption buttons -->
                <VisualState x:Name="ChromeDesktop">
                    <VisualState.Setters>
                        <Setter Target="TopBar.Margin" Value="17,40,0,0"/>
                        <Setter Target="SaveShadow.Margin" Value="0,40,12,0"/>
                        <Setter Target="StickOptionsBarContent.Height" Value="88"/>
                        <Setter Target="StickOptionsBarContent.Padding" Value="16,40,20,12"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- Mobile/Continuum: sem title bar -->
                <VisualState x:Name="ChromeMobile">
                    <VisualState.Setters>
                        <Setter Target="TopBar.Margin" Value="10,18,0,0"/>
                        <Setter Target="SaveShadow.Margin" Value="0,18,12,0"/>
                        <Setter Target="StickOptionsBarContent.Height" Value="64"/>
                        <Setter Target="StickOptionsBarContent.Padding" Value="10,12,16,12"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Conteúdo rolável: header + formulário (como Account) -->
        <ScrollViewer x:Name="MainScrollViewer"
                      Padding="0"
                      ViewChanged="MainScrollViewer_ViewChanged"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="CoverHeader" Height="250" VerticalAlignment="Top">
                    <Grid.Background>
                        <ImageBrush Opacity="0.8"
                                    ImageSource="{Binding CoverUrl}"
                                    Stretch="UniformToFill"
                                    AlignmentX="Center"
                                    AlignmentY="Center"/>
                    </Grid.Background>
                    <Grid Visibility="{Binding HasCover, Converter={StaticResource InverseBoolVisibilityConverter}}">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#073169" Offset="1" />
                                <GradientStop Color="#292c30" Offset="0.35" />
                            </LinearGradientBrush>
                        </Grid.Background>
                    </Grid>
                    <Grid Background="Black" Opacity="0.3"/>

                    <!-- Sombra inferior do header: escurece a borda da capa para separar do formulário -->
                    <Rectangle VerticalAlignment="Bottom"
                               Height="80"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#B3000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Windows10FallCreatorsUpdate:Spacing="28">
                        <Viewbox x:Name="AvatarPanel" Width="110" HorizontalAlignment="Center">
                            <Grid Width="176" Height="176">
                                <toolkit:DropShadowPanel BlurRadius="50"
                                                         OffsetX="0"
                                                         OffsetY="1"
                                                         ShadowOpacity="0.5"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center">
                                    <Grid Width="160"
                                          Height="160"
                                          CornerRadius="80"
                                          Background="{StaticResource SystemControlAcrylicElementBrush}">
                                        <FontIcon FontFamily="{StaticResource FluentUIGlyphs}"
                                                  FontSize="30"
                                                  Foreground="#01b96b"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Glyph="&#xE77B;"/>
                                        <Ellipse Width="160"
                                                 Height="160"
                                                 Visibility="{Binding HasAvatar, Converter={StaticResource BoolVisibilityConverter}}">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                </toolkit:DropShadowPanel>
                                <toolkit:DropShadowPanel HorizontalAlignment="Right"
                                                         VerticalAlignment="Bottom"
                                                         OffsetY="2"
                                                         OffsetX="0"
                                                         BlurRadius="12"
                                                         ShadowOpacity="0.45">
                                    <controls:ProfilePhotoButton Width="36"
                                                                 Height="36"
                                                                 EditCommand="{Binding EditAvatarCommand}"/>
                                </toolkit:DropShadowPanel>
                            </Grid>
                        </Viewbox>

                        <toolkit:DropShadowPanel BlurRadius="20"
                                                 OffsetX="0"
                                                 OffsetY="2"
                                                 ShadowOpacity="0.5"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,8,0,0">
                            <Button Style="{StaticResource FollowButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Command="{Binding EditCoverCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="{StaticResource SegoeMDLGlyphs}"
                                              FontSize="12"
                                              Glyph="&#xE91B;"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
                                    <TextBlock x:Uid="EditProfileEditCover"
                                               Text="Edit cover"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </toolkit:DropShadowPanel>
                    </StackPanel>
                </Grid>

                <!-- Stretch + MaxWidth: ocupa a largura toda até 800px; acima disso o UWP centraliza -->
                <Grid Grid.Row="1" Padding="16,16,16,32" x:Name="FormBody">
                    <StackPanel MaxWidth="800"
                                HorizontalAlignment="Stretch"
                                Windows10FallCreatorsUpdate:Spacing="12">

                        <TextBlock x:Uid="EditProfileUsernameLabel"
                                   Text="Username"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Opacity="0.85"
                                   Margin="4,8,0,0"/>
                        <TextBox x:Uid="EditProfileUsername"
                                 Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Username"
                                 MaxLength="63"/>

                        <TextBlock x:Uid="EditProfileBioLabel"
                                   Text="Public bio"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Opacity="0.85"
                                   Margin="4,8,0,0"/>
                        <TextBox x:Uid="EditProfileBio"
                                 Text="{Binding Bio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Tell people a little about yourself"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 MaxLength="2500"/>
                        <TextBlock FontSize="10"
                                   HorizontalAlignment="Right"
                                   Margin="0,-4,4,0">
                            <Run Foreground="{Binding IsBioWithinLimit, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=#B8BCC5|#ff4444}"
                                 Text="{Binding BioCharCount}"/>
                            <Run Foreground="#B8BCC5" Text=" / 2500"/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="4,16,0,4">
                            <FontIcon FontFamily="{StaticResource SegoeMDLGlyphs}"
                                      FontSize="14"
                                      Glyph="&#xE72E;"
                                      Opacity="0.8"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                            <TextBlock x:Uid="EditProfilePrivateSection"
                                       Text="Private"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Uid="EditProfileEmailLabel"
                                   Text="Email"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Opacity="0.85"
                                   Margin="4,4,0,0"/>
                        <TextBox x:Uid="EditProfileEmail"
                                 Text="{Binding Email, Mode=OneWay}"
                                 PlaceholderText="Email"
                                 IsReadOnly="True"
                                 InputScope="EmailSmtpAddress"/>

                        <Button x:Uid="EditProfileChangePassword"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ChangePasswordCommand}"
                                Content="Change password"/>

                        <Button x:Uid="EditProfileDeleteAccount"
                                Margin="0,8,0,24"
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                BorderBrush="#E81123"
                                BorderThickness="1"
                                Foreground="#E81123"
                                Command="{Binding DeleteAccountCommand}"
                                Content="Delete account"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Top bar flutuante (some quando a sticky aparece) -->
        <StackPanel x:Name="TopBar"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="11,15,0,0">
            <Button x:Name="LeaveFloatButton"
                    Command="{Binding LeaveCurrentPage}"
                    Style="{StaticResource CircleButtonStyle}"
                    Width="30"
                    Height="30"
                    Background="#19191C"
                    Opacity="1">
                <FontIcon FontSize="14"
                          FontWeight="ExtraBold"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontFamily="{StaticResource FluentUIGlyphs}"
                          Foreground="White"
                          Glyph="&#xE72B;"/>
            </Button>
            <TextBlock x:Uid="EditProfilePageTitle"
                       Text="Edit Profile"
                       FontWeight="SemiBold"
                       FontSize="18"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>
        </StackPanel>

        <toolkit:DropShadowPanel x:Name="SaveShadow"
                                 VerticalAlignment="Top"
                                 HorizontalAlignment="Right"
                                 Margin="0,15,12,0"
                                 OffsetY="2"
                                 OffsetX="0"
                                 BlurRadius="16"
                                 ShadowOpacity="0.45">
            <Button x:Name="SaveFloatButton"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource CircleButtonStyle}"
                    Background="Transparent"
                    Padding="0"
                    Width="30"
                    Height="30"
                    Opacity="{Binding SaveButtonOpacity}"
                    IsHitTestVisible="{Binding CanSave}"
                    ToolTipService.ToolTip="Save">
                <FontIcon FontFamily="{StaticResource SegoeMDLGlyphs}"
                          FontSize="18"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="White"
                          Glyph="&#xE74E;"/>
            </Button>
        </toolkit:DropShadowPanel>

        <!-- Sticky bar ao rolar: voltar + "Edit Profile" (+ save) -->
        <toolkit:DropShadowPanel x:Name="StickOptionsBar"
                                 OffsetY="5"
                                 BlurRadius="20"
                                 ShadowOpacity="0.4"
                                 Opacity="0"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Top"
                                 HorizontalContentAlignment="Stretch">
            <Grid x:Name="StickOptionsBarContent"
                  Height="56"
                  Background="#2F3035"
                  Padding="8,8,12,8"
                  HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding LeaveCurrentPage}"
                        Style="{StaticResource CircleButtonStyle}"
                        Width="30"
                        Height="30"
                        Background="#19191C"
                        VerticalAlignment="Center">
                    <FontIcon FontSize="14"
                              FontWeight="ExtraBold"
                              FontFamily="{StaticResource FluentUIGlyphs}"
                              Foreground="White"
                              Glyph="&#xE72B;"/>
                </Button>
                <TextBlock Grid.Column="1"
                           x:Uid="EditProfilePageTitle"
                           Text="Edit Profile"
                           FontWeight="SemiBold"
                           FontSize="18"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
                <Button Grid.Column="2"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource CircleButtonStyle}"
                        Background="Transparent"
                        Width="30"
                        Height="30"
                        VerticalAlignment="Center"
                        Opacity="{Binding SaveButtonOpacity}"
                        IsHitTestVisible="{Binding CanSave}"
                        ToolTipService.ToolTip="Save">
                    <FontIcon FontFamily="{StaticResource SegoeMDLGlyphs}"
                              FontSize="18"
                              Foreground="White"
                              Glyph="&#xE74E;"/>
                </Button>
            </Grid>
        </toolkit:DropShadowPanel>
    </Grid>
</Page>
