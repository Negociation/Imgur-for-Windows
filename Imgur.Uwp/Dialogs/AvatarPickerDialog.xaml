<ContentDialog
    x:Class="Imgur.Uwp.Dialogs.AvatarPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Windows10version1809="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 7)"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    Background="#34343A"
    Opacity="1"
    Windows10version1809:CornerRadius="5"
    FullSizeDesired="False"
    MinWidth="400"
    VerticalAlignment="Center">

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0,10,0,10</Thickness>
        <!-- Limite de largura via template: MaxWidth no root do ContentDialog tira o dialog do centro. -->
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="480" MinHeight="400" MaxHeight="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header (mesmo padrão do CommentDialog) -->
        <Grid Grid.Row="0" Padding="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="AvatarPickerDialogTitle"
                       Text="Escolher avatar"
                       Grid.Column="0"
                       Foreground="#2fbe7c"
                       FontSize="20"
                       VerticalAlignment="Top"
                       Margin="0,3,0,0"/>
            <Button Grid.Column="1"
                    Width="33"
                    Height="32"
                    BorderThickness="1"
                    BorderBrush="#585D6A"
                    Background="Transparent"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Padding="0"
                    Tapped="Close_Tapped">
                <FontIcon FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Foreground="#2fbe7c"
                          FontFamily="ms-appx:///Assets/fonts/segmdl2.ttf#Segoe MDL2 Assets"
                          FontSize="12"
                          Glyph="&#xE8BB;"/>
            </Button>
        </Grid>

        <GridView Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  SelectionMode="Single"
                  Padding="10,8,10,0"
                  ShowsScrollingPlaceholders="False">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="88" Height="100" Margin="4" Background="Transparent" ToolTipService.ToolTip="{Binding DisplayName}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Width="72"
                                Height="72"
                                CornerRadius="36"
                                HorizontalAlignment="Center"
                                Background="#2A2B30">
                            <Ellipse Width="72" Height="72">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding ImagePath}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding DisplayName}"
                                   FontSize="10"
                                   Opacity="0.85"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   Margin="0,4,0,0"/>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <Grid Grid.Row="2" Padding="10,8,10,4">
            <Button x:Uid="AvatarPickerDialogSelect"
                    Content="Selecionar"
                    HorizontalAlignment="Right"
                    MinWidth="120"
                    Height="36"
                    Background="#2fbe7c"
                    Foreground="Black"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    IsEnabled="{Binding HasSelection}"
                    Click="Select_Click"/>
        </Grid>
    </Grid>
</ContentDialog>
