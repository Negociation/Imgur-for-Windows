<ContentDialog
    x:Class="Imgur.Uwp.Dialogs.NotificationsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Imgur.Models"
    xmlns:Windows10version1809="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 7)"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    Background="#34343A"
    Opacity="1"
    Windows10version1809:CornerRadius="5"
    FullSizeDesired="False"
    MinWidth="400"
    VerticalAlignment="Center">

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0,10,0,10</Thickness>
        <!-- Limite de largura via template: MaxWidth no root do ContentDialog tira o dialog do centro. -->
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    </ContentDialog.Resources>

    <Grid MinHeight="280" MaxHeight="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header (mesmo padrão do CommentDialog) -->
        <Grid Grid.Row="0" Padding="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="NotificationsDialogTitle"
                       Text="Notificações"
                       Grid.Column="0"
                       Foreground="#2fbe7c"
                       FontSize="20"
                       VerticalAlignment="Top"
                       Margin="0,3,0,0"/>
            <Button Grid.Column="1"
                    Width="33"
                    Height="32"
                    BorderThickness="1"
                    BorderBrush="#585D6A"
                    Background="Transparent"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Padding="0"
                    Tapped="Close_Tapped">
                <FontIcon FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Foreground="#2fbe7c"
                          FontFamily="ms-appx:///Assets/fonts/segmdl2.ttf#Segoe MDL2 Assets"
                          FontSize="12"
                          Glyph="&#xE8BB;"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ProgressBar IsIndeterminate="True"
                         VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibilityConverter}}"/>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibilityConverter}}">
                <FontIcon Glyph="&#xE7ED;"
                          FontFamily="ms-appx:///Assets/fonts/segmdl2.ttf#Segoe MDL2 Assets"
                          FontSize="48"
                          Foreground="#2fbe7c"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,16"/>
                <TextBlock x:Uid="NotificationsDialogEmpty"
                           Text="Tudo em dia. Nenhuma Notificação para mostrar..."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="280"
                           FontSize="14"
                           Foreground="#B8BCC5"/>
            </StackPanel>

            <ListView ItemsSource="{Binding Items}"
                      SelectionMode="None"
                      ShowsScrollingPlaceholders="False"
                      Padding="10,8,10,0"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolVisibilityConverter}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,4"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AccountNotification">
                        <Grid Padding="12,10" Background="#2A2B30" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="36" Height="36" VerticalAlignment="Top" Margin="0,0,10,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{x:Bind AvatarUrl}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Title}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="White"/>
                                <TextBlock Text="{x:Bind Body}"
                                           FontSize="12"
                                           Opacity="0.75"
                                           TextWrapping="Wrap"
                                           MaxLines="3"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0"
                                           Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</ContentDialog>
